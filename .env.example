# Aegis configuration. Placeholders only; never commit real values.

# SQLite database path. Contains raw evidence, including attempted passwords: restrict access.
AEGIS_DB=./data/aegis.sqlite3

# Live Cowrie JSONL log (cowrie.json, not cowrie.log). Leave unset to disable the collector.
AEGIS_COWRIE_LOG=/path/to/cowrie/var/log/cowrie/cowrie.json
# Name recorded as the live source's provenance.
AEGIS_SOURCE_ID=cowrie-live

# Bind address and port. Keep loopback unless a reviewed access-control plan exists.
AEGIS_BIND=127.0.0.1
AEGIS_PORT=8000

# Optional local AI drafts (off when unset). Must be an HTTP loopback address.
AEGIS_OLLAMA_MODEL=
AEGIS_OLLAMA_URL=http://127.0.0.1:11434
AEGIS_OLLAMA_TIMEOUT=45
