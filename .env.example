# Aegis configuration. Placeholders only; never commit real values.

# development (default) or production. Production requires sign-in and AEGIS_SECRET_KEY, and secure cookies.
AEGIS_ENV=development
# required or off. Accounts: python -m aegis.users add <name> --role analyst
AEGIS_AUTH=off
# 32+ characters from your secret manager: python -c 'import secrets; print(secrets.token_hex(32))'
AEGIS_SECRET_KEY=
# Reverse-proxy deployments: extra hostnames (comma-separated) and the proxy's address.
AEGIS_TRUSTED_HOSTS=
AEGIS_TRUSTED_PROXY=
# Optional bearer token for metrics scrapers.
AEGIS_METRICS_TOKEN=
# Optional: purge raw evidence bytes older than this many days (digests and chain stay verifiable).
AEGIS_RAW_RETENTION_DAYS=

# SQLite database path. Contains raw evidence, including attempted passwords: restrict access.
AEGIS_DB=./data/aegis.sqlite3

# Live Cowrie JSONL log (cowrie.json, not cowrie.log). Leave unset to disable the collector.
AEGIS_COWRIE_LOG=/path/to/cowrie/var/log/cowrie/cowrie.json
# Name recorded as the live source's provenance.
AEGIS_SOURCE_ID=cowrie-live

# Optional read-only Suricata EVE alerts (eve.json). Nothing is ever blocked by Aegis.
AEGIS_SURICATA_EVE=
AEGIS_SURICATA_SENSOR=suricata

# Optional JSON file with detection thresholds (see docs/DETECTION.md). Defaults apply when unset.
AEGIS_DETECTION_CONFIG=

# Optional Isolation Forest model directory (python -m aegis.ml train). Used only when the detection
# settings set "ml_enabled": true. The directory must be operator-controlled: models are verified by
# digest, but a trusted directory is still required because loading uses pickle.
AEGIS_ML_MODEL_DIR=

# Bind address and port. Keep loopback unless a reviewed access-control plan exists.
AEGIS_BIND=127.0.0.1
AEGIS_PORT=8000

# Optional local AI drafts (off when unset). Must be an HTTP loopback address.
AEGIS_OLLAMA_MODEL=
AEGIS_OLLAMA_URL=http://127.0.0.1:11434
AEGIS_OLLAMA_TIMEOUT=45
